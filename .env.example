# ---------------------------------------------------------------------------
# WHERE TO GET THESE BACK
#
# Vercel marks most of these "Sensitive", which makes them write-only — not
# readable by the dashboard, the CLI, `vercel env pull`, or the API. That is a
# feature, not a loss: the values are intact and in use by production. But it
# does mean Vercel is NOT your backup. Each key's real home is:
#
#   SUPABASE_URL                  public — https://xluasplhfbuxgridtsmd.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY     Supabase -> Settings -> API
#   GOOGLE_MAPS_SERVER_API_KEY    Google Cloud -> APIs & Services -> Credentials
#   GOOGLE_SOLAR_API_KEY          Google Cloud -> APIs & Services -> Credentials
#   UPSTASH_REDIS_REST_URL        Upstash console -> your Redis database
#   UPSTASH_REDIS_REST_TOKEN      Upstash console -> your Redis database
#   RESEND_API_KEY                Resend -> API Keys (create new; cannot re-view)
#   SENTRY_DSN                    Sentry -> Settings -> Client Keys (DSN)
#   LEAD_NOTIFY_FROM              "Belpa <hello@belpa.co.uk>"
#   BELPA_ALLOWED_ORIGINS         localhost ports for dev; widget origin in prod
#
# Local setup: `vercel link && vercel env pull .env.local` gets everything
# scoped to Development. Anything missing after that has to come from the list
# above — add it in Vercel with Development ticked so the next person can pull
# it instead of asking.
# ---------------------------------------------------------------------------

# Server-only Google keys. Restrict these by server IP and by API.
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_SOLAR_API_KEY=

# Receives the complete lead JSON payload (optional; best-effort after DB write).
# Must be https. Optional host allowlist and HMAC secret for X-Quoter-Signature.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_ALLOWED_HOSTS=
LEAD_WEBHOOK_SECRET=

# Resend — emails the roofer when a new lead lands (optional; best-effort after
# the DB write, never fails the request). Recipients are the login emails of the
# roofer's linked members. Without RESEND_API_KEY, lead emails are disabled.
# LEAD_NOTIFY_FROM must use a Resend-verified domain. The fallback
# ("Belpa <onboarding@resend.dev>") is Resend's shared sandbox sender and only
# delivers to your own account address — so leaving this unset means roofers
# silently never receive their leads. Production is set to
# "Belpa <hello@belpa.co.uk>" (belpa.co.uk verified in Resend, DKIM + SPF live).
# Reply-To defaults to the homeowner's email; set REPLY_TO_LEAD=false to disable.
RESEND_API_KEY=
LEAD_NOTIFY_FROM=
LEAD_NOTIFY_REPLY_TO_LEAD=

# Supabase (service role — server only). When set, POST /api/lead persists
# into public.leads after resolving roofers.slug = payload.rooferId.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Upstash Redis — rate limiting + solar/geocode response cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated FIRST-PARTY origins allowed to call this API from a browser.
# The quote flow runs inside our widget iframe, so production only needs the
# widget origin (and localhost in dev) — NOT every roofer website.
# Example: https://quote.getquoter.io,https://quoter-widget-frontend.vercel.app
# Enumerate Vercel preview origins explicitly — there is no wildcard preview
# regex (that namespace is globally first-come-first-served).
# Per-roofer site locks use roofers.allowed_origins + ?host= from the loaders.
# The default "*" allows any origin — fine for development; tighten in production.
QUOTER_ALLOWED_ORIGINS=*
